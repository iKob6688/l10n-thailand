<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_sequence_form_inherit" model="ir.ui.view">
        <field name="name">sequence_view_inherit</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='number_next_actual']" position="after">
                <field name="preview" />
            </xpath>
            <xpath
                expr="//field[@name='date_range_ids']/tree/field[last()]"
                position="after"
            >
                <field name="preview" />
            </xpath>
            <!-- Replace fragile index-based XPaths with a more robust one -->
            <!-- Remove old XPaths for help text (done by not re-adding them) -->
            <xpath expr="//field[@name='suffix']" position="after">
                <div class="o_form_label">
                  Additional Thai Localization Variables:
                </div>
                <div>
                    <span style="margin-left: 10px;">Quarter of the Year: %%(qoy)s</span>
                </div>
                <div>
                    <span style="margin-left: 10px;">Current Buddhist Era (BE) year with century: %%(year_be)s</span>
                </div>
                <div>
                    <span style="margin-left: 10px;">Current Buddhist Era (BE) Year without Century: %%(y_be)s</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
